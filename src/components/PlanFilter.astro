---
import { withBase } from '../lib/paths';

interface Props {
  mode?: 'mobile' | 'broadband';
  carriers: { id: string; name: string }[];
  /** 預先揀好電訊商（例如由品牌專頁帶入） */
  initialCarrier?: string;
  /** 預先揀好場景 */
  initialScenario?: string;
  /** 預先揀好物業類型 */
  initialHousing?: string;
  /** 鎖死電訊商（專頁已選定，唔使再揀） */
  lockCarrier?: boolean;
  /** 鎖死場景 */
  lockScenario?: boolean;
}

const {
  mode = 'mobile',
  carriers,
  initialCarrier = '',
  initialScenario = '',
  initialHousing = '',
  lockCarrier = false,
  lockScenario = false,
} = Astro.props;

const lockedCarrierName =
  lockCarrier && initialCarrier
    ? carriers.find((c) => c.id === initialCarrier)?.name || initialCarrier
    : '';

const browseAllHref =
  mode === 'mobile' ? withBase('/mobile-plan/') : withBase('/broadband/');
---

<section
  class="rounded-2xl border border-line bg-white/90 p-4 shadow-sm sm:p-5"
  data-plan-filter={mode}
  data-initial-carrier={initialCarrier}
  data-initial-scenario={initialScenario}
  data-initial-housing={initialHousing}
  data-lock-carrier={lockCarrier ? '1' : '0'}
  data-lock-scenario={lockScenario ? '1' : '0'}
  aria-label="計劃篩選"
>
  {
    lockedCarrierName && (
      <p class="mb-3 text-sm text-ink-soft">
        已選擇：<span class="font-semibold text-sea">{lockedCarrierName}</span>
        <a href={browseAllHref} class="ml-2 text-sea underline">
          改睇其他電訊商
        </a>
      </p>
    )
  }

  <div class="flex flex-wrap items-end gap-4">
    {
      !lockCarrier && (
        <label class="flex min-w-[140px] flex-1 flex-col gap-1.5 text-sm">
          <span class="font-medium text-ink-soft">電訊商</span>
          <select
            data-filter="carrier"
            class="rounded-lg border border-line bg-white px-3 py-2.5 text-sm"
          >
            <option value="">全部</option>
            {carriers.map((c) => (
              <option value={c.id} selected={c.id === initialCarrier}>
                {c.name}
              </option>
            ))}
          </select>
        </label>
      )
    }
    {
      lockCarrier && (
        <input type="hidden" data-filter="carrier" value={initialCarrier} />
      )
    }

    <label class="flex min-w-[140px] flex-1 flex-col gap-1.5 text-sm">
      <span class="font-medium text-ink-soft">月費預算</span>
      <select data-filter="budget" class="rounded-lg border border-line bg-white px-3 py-2.5 text-sm">
        <option value="">不限</option>
        <option value="0-100">$100 或以下</option>
        <option value="101-150">$101 – $150</option>
        <option value="151-200">$151 – $200</option>
        <option value="201-9999">$201 或以上</option>
      </select>
    </label>

    {
      mode === 'mobile' ? (
        !lockScenario ? (
          <label class="flex min-w-[140px] flex-1 flex-col gap-1.5 text-sm">
            <span class="font-medium text-ink-soft">場景</span>
            <select
              data-filter="scenario"
              class="rounded-lg border border-line bg-white px-3 py-2.5 text-sm"
            >
              <option value="">全部場景</option>
              <option value="gba" selected={initialScenario === 'gba'}>
                大灣區／一卡兩號
              </option>
              <option value="student" selected={initialScenario === 'student'}>
                學生 Plan
              </option>
              <option value="cheap4g" selected={initialScenario === 'cheap4g'}>
                平價 4.5G
              </option>
            </select>
          </label>
        ) : (
          <input type="hidden" data-filter="scenario" value={initialScenario} />
        )
      ) : (
        <label class="flex min-w-[140px] flex-1 flex-col gap-1.5 text-sm">
          <span class="font-medium text-ink-soft">物業類型</span>
          <select
            data-filter="housing"
            class="rounded-lg border border-line bg-white px-3 py-2.5 text-sm"
          >
            <option value="">全部</option>
            <option value="公屋" selected={initialHousing === '公屋'}>
              公屋
            </option>
            <option value="居屋" selected={initialHousing === '居屋'}>
              居屋
            </option>
            <option value="私樓" selected={initialHousing === '私樓'}>
              私樓
            </option>
          </select>
        </label>
      )
    }

    <button type="button" data-filter-reset class="btn-ghost text-sm">
      重設
    </button>
  </div>
  <p class="mt-3 text-xs text-muted">
    即時篩選結果：<span data-filter-count>—</span> 個計劃
  </p>
</section>

<script>
  function initFilters() {
    document.querySelectorAll<HTMLElement>('[data-plan-filter]').forEach((root) => {
      if (root.dataset.filterReady === '1') return;
      root.dataset.filterReady = '1';

      const mode = root.getAttribute('data-plan-filter');
      const lockCarrier = root.dataset.lockCarrier === '1';
      const lockScenario = root.dataset.lockScenario === '1';
      const scope = root.closest('section')?.parentElement ?? document;
      const cards = () =>
        Array.from(scope.querySelectorAll<HTMLElement>('.plan-card, tr[data-carrier]'));
      const countEl = root.querySelector('[data-filter-count]');

      const carrierEl = root.querySelector('[data-filter="carrier"]') as
        | HTMLSelectElement
        | HTMLInputElement
        | null;
      const scenarioEl = root.querySelector('[data-filter="scenario"]') as
        | HTMLSelectElement
        | HTMLInputElement
        | null;
      const housingEl = root.querySelector('[data-filter="housing"]') as HTMLSelectElement | null;
      const budgetEl = root.querySelector('[data-filter="budget"]') as HTMLSelectElement | null;

      // URL ?carrier= / ?scenario= / ?housing= 優先（總比較頁用）
      const params = new URLSearchParams(window.location.search);
      const urlCarrier = params.get('carrier')?.trim() || '';
      const urlScenario = params.get('scenario')?.trim() || '';
      const urlHousing = params.get('housing')?.trim() || '';
      const urlBudget = params.get('budget')?.trim() || '';

      if (carrierEl && !lockCarrier) {
        const fromData = root.dataset.initialCarrier || '';
        const next = urlCarrier || fromData;
        if (next) carrierEl.value = next;
      }
      if (scenarioEl && !lockScenario) {
        const fromData = root.dataset.initialScenario || '';
        const next = urlScenario || fromData;
        if (next) scenarioEl.value = next;
      }
      if (housingEl) {
        const fromData = root.dataset.initialHousing || '';
        const next = urlHousing || fromData;
        if (next) housingEl.value = next;
      }
      if (budgetEl && urlBudget) budgetEl.value = urlBudget;

      const apply = () => {
        const carrier = carrierEl?.value || '';
        const budget = budgetEl?.value || '';
        const scenario = scenarioEl?.value || '';
        const housing = housingEl?.value || '';

        cards().forEach((el) => {
          const fee = Number(el.dataset.fee || 0);
          const elCarrier = el.dataset.carrier || '';
          let ok = true;

          if (carrier && elCarrier !== carrier) ok = false;

          if (budget) {
            const [min, max] = budget.split('-').map(Number);
            if (fee < min || fee > max) ok = false;
          }

          if (mode === 'mobile' && scenario) {
            if (scenario === 'gba' && el.dataset.gba !== 'true') ok = false;
            if (scenario === 'student' && el.dataset.student !== 'true') ok = false;
            if (scenario === 'cheap4g' && el.dataset.cheap4g !== 'true') ok = false;
          }

          if (mode === 'broadband' && housing) {
            const types = el.dataset.housing || '';
            if (!types.includes(housing)) ok = false;
          }

          el.style.display = ok ? '' : 'none';
        });

        const cardVisible = cards().filter(
          (el) => el.classList.contains('plan-card') && el.style.display !== 'none',
        ).length;
        if (countEl) countEl.textContent = String(cardVisible);
      };

      root.querySelectorAll('select').forEach((sel) => sel.addEventListener('change', apply));
      root.querySelector('[data-filter-reset]')?.addEventListener('click', () => {
        root.querySelectorAll('select').forEach((sel) => {
          const s = sel as HTMLSelectElement;
          if (lockCarrier && s.dataset.filter === 'carrier') return;
          if (lockScenario && s.dataset.filter === 'scenario') return;
          s.value = '';
        });
        // 鎖死嘅 hidden input 保持
        apply();
      });

      apply();
    });
  }

  initFilters();
  document.addEventListener('astro:page-load', initFilters);
</script>
