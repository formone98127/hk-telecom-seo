---
import type { BroadbandPlan, MobilePlan } from '../lib/types';
import { carrierBadgeClass } from '../lib/carriers';

interface Props {
  plan: MobilePlan | BroadbandPlan;
  kind?: 'mobile' | 'broadband';
}

const { plan, kind = 'mobile' } = Astro.props;
const isMobile = kind === 'mobile';
const mobile = plan as MobilePlan;
const broadband = plan as BroadbandPlan;
const badge = carrierBadgeClass[plan.carrier] ?? 'bg-foam text-sea';

const planPayload = JSON.stringify({
  id: plan.id,
  carrier: plan.carrierName,
  name: plan.planName,
  fee: plan.monthlyFee,
  kind,
});
---

<article
  class:list={['plan-card', plan.isRecommended && 'is-recommended']}
  data-carrier={plan.carrier}
  data-fee={plan.monthlyFee}
  data-gba={isMobile ? String(mobile.isGba) : undefined}
  data-student={isMobile ? String(mobile.isStudent) : undefined}
  data-cheap4g={isMobile ? String(mobile.isCheap4g) : undefined}
  data-housing={isMobile ? undefined : broadband.housingTypes}
  data-speed={isMobile ? undefined : broadband.speedMbps}
>
  {
    plan.isRecommended && (
      <div class="mb-3 inline-flex w-fit items-center gap-1.5 rounded-md bg-sea px-2.5 py-1 text-xs font-semibold text-white">
        <span aria-hidden="true">★</span>
        編輯推介 · 高性價比
      </div>
    )
  }

  <div class="flex items-start justify-between gap-3">
    <div>
      <span class:list={['inline-flex rounded-md px-2 py-0.5 text-xs font-semibold', badge]}>
        {plan.carrierName}
      </span>
      <h3 class="mt-2 text-base font-bold text-ink sm:text-lg">{plan.planName}</h3>
    </div>
    <div class="text-right">
      <p class="text-xs text-muted">每月</p>
      <p class="font-display text-2xl font-bold text-sea">
        ${plan.monthlyFee}
      </p>
    </div>
  </div>

  <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
    {
      isMobile ? (
        <>
          <div>
            <dt class="text-xs text-muted">網絡</dt>
            <dd class="font-medium">{mobile.network}</dd>
          </div>
          <div>
            <dt class="text-xs text-muted">本地數據</dt>
            <dd class="font-medium">{mobile.dataLocal}</dd>
          </div>
          <div>
            <dt class="text-xs text-muted">大灣區數據</dt>
            <dd class="font-medium">{mobile.dataGba}</dd>
          </div>
          <div>
            <dt class="text-xs text-muted">合約期</dt>
            <dd class="font-medium">{mobile.contractMonths} 個月</dd>
          </div>
        </>
      ) : (
        <>
          <div>
            <dt class="text-xs text-muted">網速</dt>
            <dd class="font-medium">{broadband.speedMbps}M</dd>
          </div>
          <div>
            <dt class="text-xs text-muted">適用物業</dt>
            <dd class="font-medium">{broadband.housingTypes}</dd>
          </div>
          <div>
            <dt class="text-xs text-muted">合約期</dt>
            <dd class="font-medium">{broadband.contractMonths} 個月</dd>
          </div>
          <div>
            <dt class="text-xs text-muted">拉線</dt>
            <dd class="font-medium line-clamp-2">{broadband.installNote}</dd>
          </div>
        </>
      )
    }
  </dl>

  {
    plan.highlights && (
      <p class="mt-3 text-sm text-ink-soft">{plan.highlights}</p>
    )
  }

  {
    plan.hiddenPerk && (
      <details class="mt-3 rounded-lg bg-foam/80 px-3 py-2 text-sm">
        <summary class="cursor-pointer font-medium text-sea">隱藏優惠亮點</summary>
        <p class="mt-1.5 text-ink-soft">{plan.hiddenPerk}</p>
      </details>
    )
  }

  <div class="mt-5 grow"></div>

  <a
    href="#"
    class="btn-wa wa-link w-full"
    data-plan={planPayload}
    data-wa-message={`你好，我想查詢「${plan.carrierName} ${plan.planName}」（月費 $${plan.monthlyFee}），請幫我介紹最新優惠同攜號轉台安排，謝謝！`}
  >
    WhatsApp 查詢此 Plan
  </a>
</article>
