---
import { BadgeCheck, MessageCircle, Sparkles } from '@lucide/astro';
import type { BroadbandPlan, MobilePlan } from '../lib/types';
import { carrierBadgeClass, carrierBrandBarClass } from '../lib/carriers';

interface Props {
  plan: MobilePlan | BroadbandPlan;
  kind?: 'mobile' | 'broadband';
}

const { plan, kind = 'mobile' } = Astro.props;
const isMobile = kind === 'mobile';
const mobile = plan as MobilePlan;
const broadband = plan as BroadbandPlan;
const badge = carrierBadgeClass[plan.carrier] ?? 'bg-slate-100 text-slate-600';
const brandBar = carrierBrandBarClass[plan.carrier] ?? 'brand-bar-other';

const speedLabel =
  !isMobile && broadband.speedMbps === 5
    ? '5G 家居'
    : !isMobile
      ? `${broadband.speedMbps}M`
      : '';

const planPayload = JSON.stringify({
  id: plan.id,
  carrier: plan.carrierName,
  name: plan.planName,
  fee: plan.monthlyFee,
  kind,
  sourceId: plan.sourceId || '',
});
---

<article
  class:list={['plan-card', plan.isRecommended && 'is-recommended']}
  data-carrier={plan.carrier}
  data-fee={plan.monthlyFee}
  data-gba={isMobile ? String(mobile.isGba) : undefined}
  data-student={isMobile ? String(mobile.isStudent) : undefined}
  data-cheap4g={isMobile ? String(mobile.isCheap4g) : undefined}
  data-housing={isMobile ? undefined : broadband.housingTypes}
  data-speed={isMobile ? undefined : broadband.speedMbps}
>
  <div class:list={['absolute inset-x-0 top-0 h-1', brandBar]} aria-hidden="true"></div>

  <div class="mb-3 flex flex-wrap items-center gap-2">
    {
      plan.isRecommended && (
        <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-600 px-2.5 py-1 text-xs font-semibold text-white shadow-sm">
          <Sparkles class="h-3.5 w-3.5" stroke-width={2} />
          編輯首選
        </span>
      )
    }
    {
      plan.isVerified && (
        <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600">
          <BadgeCheck class="h-3.5 w-3.5 text-blue-600" stroke-width={2} />
          已認證
        </span>
      )
    }
  </div>

  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <span class:list={['inline-flex rounded-md px-2 py-0.5 text-xs font-semibold', badge]}>
        {plan.carrierName}
      </span>
      <h3 class="mt-2 line-clamp-2 text-base font-semibold tracking-tight text-slate-900 sm:text-lg">
        {plan.planName}
      </h3>
      {
        plan.sourceUpdatedAt && (
          <p class="mt-1 text-xs text-slate-500">市況更新：{plan.sourceUpdatedAt}</p>
        )
      }
    </div>
    <div class="shrink-0 text-right">
      <p class="text-xs text-slate-500">每月</p>
      <p class="font-display text-2xl font-bold tabular-nums tracking-tight text-slate-900" data-price>
        <span class="text-base font-semibold text-slate-500">$</span>{plan.monthlyFee}
      </p>
    </div>
  </div>

  <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
    {
      isMobile ? (
        <>
          <div>
            <dt class="text-xs text-slate-500">網絡</dt>
            <dd class="font-medium text-slate-800">{mobile.network}</dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">本地數據</dt>
            <dd class="font-medium text-slate-800">{mobile.dataLocal}</dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">大灣區數據</dt>
            <dd class="font-medium text-slate-800">{mobile.dataGba}</dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">合約期</dt>
            <dd class="font-medium tabular-nums text-slate-800">{mobile.contractMonths} 個月</dd>
          </div>
        </>
      ) : (
        <>
          <div>
            <dt class="text-xs text-slate-500">網速</dt>
            <dd class="font-medium tabular-nums text-slate-800">{speedLabel}</dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">適用物業</dt>
            <dd class="font-medium text-slate-800">{broadband.housingTypes}</dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">合約期</dt>
            <dd class="font-medium tabular-nums text-slate-800">
              {broadband.contractMonths} 個月
            </dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">拉線</dt>
            <dd class="line-clamp-2 font-medium text-slate-800">{broadband.installNote}</dd>
          </div>
        </>
      )
    }
  </dl>

  {
    plan.siblingPrices && (
      <p class="mt-3 rounded-xl bg-slate-50 px-3 py-2 text-xs text-slate-600">
        <span class="font-semibold text-slate-800">同刊登價錢：</span>
        {plan.siblingPrices}
      </p>
    )
  }

  {
    plan.highlights && (
      <p class="mt-3 line-clamp-3 text-sm text-slate-600">{plan.highlights}</p>
    )
  }

  {
    plan.hiddenPerk && (
      <details class="mt-3 rounded-xl bg-blue-50/70 px-3 py-2 text-sm">
        <summary class="cursor-pointer font-medium text-blue-700">來源同其他價</summary>
        <p class="mt-1.5 text-slate-600">{plan.hiddenPerk}</p>
      </details>
    )
  }

  <div class="mt-5 grow"></div>

  <a
    href="#"
    class="btn-wa wa-link w-full"
    data-plan={planPayload}
    data-wa-message={`你好，我想查詢「${plan.carrierName} ${plan.planName}」（月費 $${plan.monthlyFee}，求Plan王市況），請幫我核對最新優惠，謝謝！`}
  >
    <MessageCircle class="h-4 w-4" stroke-width={2} />
    WhatsApp 查詢此 Plan
  </a>
</article>
