---
import { MessageCircle } from '@lucide/astro';
---

<div
  id="wa-bar"
  class="fixed inset-x-0 bottom-0 z-50 border-t border-slate-200/80 bg-white/90 p-3 shadow-[0_-8px_30px_rgba(15,23,42,0.08)] backdrop-blur-md md:hidden"
>
  <a
    href="#"
    class="btn-wa wa-link w-full"
    data-wa-message="你好，我想查詢香港手機月費／家居寬頻最新優惠，請幫我介紹，謝謝！"
  >
    <MessageCircle class="h-5 w-5" stroke-width={2} />
    WhatsApp 免費格價諮詢
  </a>
</div>

<script>
  const STORAGE_KEY = 'hk_telecom_ref_agent';
  const STORAGE_TS = 'hk_telecom_ref_ts';
  const LOCK_DAYS = 30;

  type Agent = { id: string; name: string; whatsapp: string; weight: number };

  function readAgents(): Agent[] {
    const el = document.getElementById('agents-data');
    if (!el?.textContent) return [];
    try {
      return JSON.parse(el.textContent) as Agent[];
    } catch {
      return [];
    }
  }

  function pickWeighted(agents: Agent[]): Agent {
    const total = agents.reduce((s, a) => s + (a.weight || 0), 0) || 1;
    let r = Math.random() * total;
    for (const a of agents) {
      r -= a.weight || 0;
      if (r <= 0) return a;
    }
    return agents[0];
  }

  function isExpired(ts: string | null): boolean {
    if (!ts) return true;
    const locked = Number(ts);
    if (!Number.isFinite(locked)) return true;
    return Date.now() - locked > LOCK_DAYS * 24 * 60 * 60 * 1000;
  }

  function resolveAgent(agents: Agent[]): Agent | null {
    if (!agents.length) return null;

    const params = new URLSearchParams(window.location.search);
    const ref = params.get('ref')?.trim().toLowerCase();

    if (ref) {
      const matched = agents.find((a) => a.id.toLowerCase() === ref);
      if (matched) {
        localStorage.setItem(STORAGE_KEY, matched.id);
        localStorage.setItem(STORAGE_TS, String(Date.now()));
        return matched;
      }
    }

    const savedId = localStorage.getItem(STORAGE_KEY);
    const savedTs = localStorage.getItem(STORAGE_TS);
    if (savedId && !isExpired(savedTs)) {
      const saved = agents.find((a) => a.id === savedId);
      if (saved) return saved;
    }

    const picked = pickWeighted(agents);
    localStorage.setItem(STORAGE_KEY, picked.id);
    localStorage.setItem(STORAGE_TS, String(Date.now()));
    return picked;
  }

  function buildWaUrl(phone: string, message: string): string {
    const digits = phone.replace(/\D/g, '');
    return `https://wa.me/${digits}?text=${encodeURIComponent(message)}`;
  }

  function bindLinks(agent: Agent) {
    document.querySelectorAll<HTMLAnchorElement>('a.wa-link, a.wa-btn').forEach((a) => {
      const plan = a.getAttribute('data-plan');
      const msg =
        a.getAttribute('data-wa-message') ||
        (plan
          ? `你好，我想查詢「${plan}」，請幫我介紹最新優惠，謝謝！`
          : '你好，我想查詢香港電訊月費／寬頻最新優惠，謝謝！');
      a.href = buildWaUrl(agent.whatsapp, msg);
      a.setAttribute('target', '_blank');
      a.setAttribute('rel', 'noopener noreferrer');
      a.dataset.agentId = agent.id;
    });
  }

  function initWa() {
    const agents = readAgents();
    const agent = resolveAgent(agents);
    if (agent) bindLinks(agent);
  }

  initWa();
  document.addEventListener('astro:page-load', initWa);
</script>
