---
import { withBase } from '../lib/paths';

interface Props {
  monthLabel: string;
}

const { monthLabel } = Astro.props;
const path = Astro.url.pathname;

const links = [
  { href: withBase('/mobile-plan/'), label: '手機月費' },
  { href: withBase('/broadband/'), label: '家居寬頻' },
  { href: withBase('/guides/mnp-transfer/'), label: '轉台全攻略' },
  { href: withBase('/share/'), label: '推廣連結' },
];

const homeHref = withBase('/');
---

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur-md">
  <div class="site-container flex h-14 items-center justify-between gap-4 sm:h-16">
    <a href={homeHref} class="group flex items-baseline gap-2 no-underline">
      <span class="font-display text-lg font-bold tracking-tight text-slate-900 sm:text-xl">
        電訊格價通
      </span>
      <span class="hidden text-xs text-slate-500 sm:inline">{monthLabel}更新</span>
    </a>
    <nav class="flex items-center gap-1 text-sm sm:gap-2" aria-label="主選單">
      {
        links.map((link) => {
          const active = path === link.href || path.startsWith(link.href.replace(/\/$/, ''));
          return (
            <a
              href={link.href}
              class:list={[
                'rounded-lg px-2.5 py-1.5 font-medium transition sm:px-3',
                active
                  ? 'bg-slate-900 text-white'
                  : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
