---
interface Props {
  title: string;
  description: string;
  message?: string;
}

const {
  title,
  description,
  message = '你好，我想查詢香港電訊月費／寬頻最新優惠同攜號轉台安排，請幫我介紹，謝謝！',
} = Astro.props;
---

<section class="site-container py-8">
  <div
    class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-sea via-sea-bright to-ink px-6 py-10 text-white sm:px-10"
  >
    <div
      class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/10 blur-2xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-16 left-1/3 h-48 w-48 rounded-full bg-coral/30 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="relative max-w-xl">
      <h2 class="font-display text-2xl font-bold sm:text-3xl">{title}</h2>
      <p class="mt-3 text-sm text-white/85 sm:text-base">{description}</p>
      <a href="#" class="btn-wa mt-6 wa-link" data-wa-message={message}>
        即時 WhatsApp 查詢
      </a>
    </div>
  </div>
</section>
