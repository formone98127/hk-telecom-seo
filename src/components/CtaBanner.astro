---
import { MessageCircle } from '@lucide/astro';

interface Props {
  title: string;
  description: string;
  message?: string;
}

const {
  title,
  description,
  message = '你好，我想查詢香港電訊月費／寬頻最新優惠同攜號轉台安排，請幫我介紹，謝謝！',
} = Astro.props;
---

<section class="site-container py-8">
  <div
    class="relative overflow-hidden rounded-3xl border border-slate-800 bg-slate-900 px-6 py-10 text-white shadow-sm sm:px-10"
  >
    <div
      class="pointer-events-none absolute -right-16 top-0 h-48 w-48 rounded-full bg-blue-500/20 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-20 left-1/4 h-52 w-52 rounded-full bg-emerald-500/10 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="relative max-w-xl">
      <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">{title}</h2>
      <p class="mt-3 text-sm text-slate-300 sm:text-base">{description}</p>
      <a href="#" class="btn-wa mt-6 wa-link" data-wa-message={message}>
        <MessageCircle class="h-4 w-4" stroke-width={2} />
        即時 WhatsApp 查詢
      </a>
    </div>
  </div>
</section>
