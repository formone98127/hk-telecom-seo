---
import { Building2, CalendarSync, Check, Handshake, ArrowRight, ShieldCheck } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanCard from '../components/PlanCard.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { getMobilePlans, getBroadbandPlans } from '../lib/sheets';
import { getCurrentMonthLabel, withBase } from '../lib/utils';
import { breadcrumbSchema, faqSchema, webSiteSchema } from '../lib/schema';

const monthLabel = getCurrentMonthLabel();
const mobilePlans = await getMobilePlans();
const broadbandPlans = await getBroadbandPlans();

const featuredMobile = mobilePlans.filter((p) => p.isRecommended).slice(0, 3);
const featuredBroadband = broadbandPlans.filter((p) => p.isRecommended).slice(0, 2);

const trustItems = [
  {
    icon: Building2,
    title: '涵蓋全港 6 大電訊商',
    desc: 'CMHK、3HK、csl.、SmarTone、HKBN、網上行',
  },
  {
    icon: CalendarSync,
    title: '每月 1 號同步更新',
    desc: '追貼市況隱藏優惠同最新月費',
  },
  {
    icon: Handshake,
    title: '零中介費直接對接',
    desc: 'WhatsApp 一對一查詢，唔收額外手續費',
  },
];

const faqs = [
  {
    question: '攜號轉台會唔會斷線？要幾耐？',
    answer:
      '一般申請成功後約 1–2 個工作天完成攜號轉台，轉台當日可能有短暫服務中斷（通常幾分鐘至半小時內）。建議揀非繁忙時段啟動。',
  },
  {
    question: '合約未完可以轉台嗎？',
    answer:
      '可以，但可能要支付提早終止合約費用（過冷河／餘期費用）。部分新電訊商會提供「幫你墊支／回贈」優惠，實際要以書面報價為準。',
  },
  {
    question: '點解推介中國移動香港（CMHK）？',
    answer:
      '以同期月費、數據量同大灣區配套比較，CMHK 多數計劃性價比較突出，而且免行政費、攜號轉台優惠穩定。本站仍會並列其他電訊商，方便你自行對比。',
  },
  {
    question: '公屋／居屋裝寬頻有冇限制？',
    answer:
      '有。公屋／居屋通常只有合資格電訊商可入邨拉線，亦要配合屋邨辦事處檔期。你可以先喺本站公屋專頁睇邊間有覆蓋，再 WhatsApp 查詢你嘅屋邨。',
  },
];

const schema = [
  webSiteSchema(Astro.site?.toString()),
  breadcrumbSchema([{ name: '首頁', path: '/' }], Astro.site?.toString()),
  faqSchema(faqs),
];
---

<BaseLayout
  title={`香港手機月費及寬頻格價比較｜電訊格價通`}
  description={`中立比較 CMHK、3HK、csl.、SmarTone、HKBN、網上行最新${monthLabel}月費同家居寬頻優惠，支援攜號轉台諮詢。`}
  canonical="/"
  schema={schema}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_80%_0%,rgba(37,99,235,0.08),transparent_55%)]"
      aria-hidden="true"
    >
    </div>
    <div class="site-container grid items-center gap-10 pb-10 pt-10 sm:pb-14 sm:pt-14 lg:grid-cols-2">
      <div class="fade-up">
        <p class="font-display text-sm font-semibold tracking-[0.18em] text-blue-600 uppercase">
          電訊格價通
        </p>
        <h1 class="mt-3 font-display text-3xl font-bold leading-tight tracking-tight text-slate-900 sm:text-5xl">
          香港月費同寬頻<br />一站式格價比較
        </h1>
        <p class="mt-4 max-w-lg text-base text-slate-600 sm:text-lg">
          {monthLabel}最新優惠：中立對比各大電訊商，精選高性價比 Plan，WhatsApp 一分鐘問價。
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={withBase('/mobile-plan/')} class="btn-primary">比較 5G 月費</a>
          <a href={withBase('/broadband/')} class="btn-ghost">比較家居寬頻</a>
        </div>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href={`${withBase('/mobile-plan/')}?carrier=cmhk`} class="btn-ghost !py-2 text-sm">
            中國移動香港
          </a>
          <a href={`${withBase('/mobile-plan/')}?carrier=3hk`} class="btn-ghost !py-2 text-sm">
            3HK
          </a>
          <a href={`${withBase('/mobile-plan/')}?carrier=csl`} class="btn-ghost !py-2 text-sm">
            csl.
          </a>
          <a href={`${withBase('/mobile-plan/')}?carrier=smartone`} class="btn-ghost !py-2 text-sm">
            SmarTone
          </a>
        </div>
      </div>

      <!-- Bento visual -->
      <div class="fade-up-delay-1 grid grid-cols-2 gap-3 sm:gap-4" aria-hidden="true">
        <div class="bento-card col-span-2 bg-slate-900 text-white">
          <p class="text-xs font-medium text-slate-400">本月精選參考</p>
          <p class="mt-2 font-display text-3xl font-bold tabular-nums tracking-tight">
            <span class="text-lg text-slate-400">$</span>98
            <span class="ml-1 text-sm font-medium text-slate-400">起／月</span>
          </p>
          <p class="mt-2 text-sm text-slate-300">5G 熱賣市況 · CMHK 高性價比檔</p>
        </div>
        <div class="bento-card">
          <ShieldCheck class="h-5 w-5 text-blue-600" stroke-width={2} />
          <p class="mt-3 font-display text-2xl font-bold tabular-nums text-slate-900">6+</p>
          <p class="mt-1 text-xs text-slate-500">電訊商品牌</p>
        </div>
        <div class="bento-card">
          <CalendarSync class="h-5 w-5 text-emerald-600" stroke-width={2} />
          <p class="mt-3 font-display text-2xl font-bold tabular-nums text-slate-900">1號</p>
          <p class="mt-1 text-xs text-slate-500">每月自動更新</p>
        </div>
      </div>
    </div>

    <!-- Trust bar -->
    <div class="site-container pb-12">
      <div class="fade-up-delay-2 grid gap-3 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm sm:grid-cols-3 sm:p-5">
        {
          trustItems.map((item) => {
            const Icon = item.icon;
            return (
              <div class="flex gap-3 rounded-xl px-2 py-2 sm:px-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-50 text-blue-600">
                  <Icon class="h-5 w-5" stroke-width={2} />
                </div>
                <div>
                  <p class="text-sm font-semibold text-slate-900">{item.title}</p>
                  <p class="mt-0.5 text-xs leading-relaxed text-slate-500">{item.desc}</p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Featured mobile -->
  <section class="section-pad pt-0" aria-labelledby="mobile-feat">
    <div class="site-container">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 id="mobile-feat" class="font-display text-2xl font-bold tracking-tight sm:text-3xl">
            5G 月費精選
          </h2>
          <p class="mt-2 text-sm text-slate-500">
            價錢逐項跟市況下載；CMHK 高性價比檔位列編輯首選。
          </p>
        </div>
        <a
          href={withBase('/mobile-plan/')}
          class="inline-flex items-center gap-1 text-sm font-semibold text-blue-600 hover:text-blue-700"
        >
          睇晒全部比較
          <ArrowRight class="h-4 w-4" stroke-width={2} />
        </a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {featuredMobile.map((plan) => <PlanCard plan={plan} kind="mobile" />)}
      </div>
    </div>
  </section>

  <!-- Broadband -->
  <section class="section-pad bg-white" aria-labelledby="bb-feat">
    <div class="site-container">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 id="bb-feat" class="font-display text-2xl font-bold tracking-tight sm:text-3xl">
            家居寬頻熱選
          </h2>
          <p class="mt-2 text-sm text-slate-500">1000M／2500M 格價，公屋居屋私樓都啱用。</p>
        </div>
        <a
          href={withBase('/broadband/')}
          class="inline-flex items-center gap-1 text-sm font-semibold text-blue-600 hover:text-blue-700"
        >
          寬頻總比較
          <ArrowRight class="h-4 w-4" stroke-width={2} />
        </a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {featuredBroadband.map((plan) => <PlanCard plan={plan} kind="broadband" />)}
      </div>
      <div class="mt-6 flex flex-wrap gap-3 text-sm">
        <a class="btn-ghost !py-2" href={withBase('/broadband/estate/lohas-park/')}>日出康城</a>
        <a class="btn-ghost !py-2" href={withBase('/broadband/estate/taikoo-shing/')}>太古城</a>
        <a class="btn-ghost !py-2" href={withBase('/broadband/estate/south-horizons/')}>海怡半島</a>
        <a class="btn-ghost !py-2" href={withBase('/broadband/estate/public-housing/')}>公屋寬頻</a>
      </div>
    </div>
  </section>

  <!-- MNP highlight -->
  <section class="section-pad" aria-labelledby="mnp">
    <div class="site-container grid items-center gap-8 lg:grid-cols-2">
      <div>
        <h2 id="mnp" class="font-display text-2xl font-bold tracking-tight sm:text-3xl">
          攜號轉台，慳到盡
        </h2>
        <p class="mt-3 text-slate-600">
          唔想轉號碼？攜號轉台可以保留原有電話號碼，同時轉去更抵用嘅電訊商。我哋有圖文教學拆解程序、提早轉台計費同過冷河注意事項。
        </p>
        <a href={withBase('/guides/mnp-transfer/')} class="btn-primary mt-6">睇攜號轉台全攻略</a>
      </div>
      <ul class="space-y-3">
        {
          [
            '免行政費上台機會高',
            '新商可能回贈／墊支舊約費用',
            '轉台前後 WhatsApp 一對一跟進',
          ].map((t) => (
            <li class="bento-card flex items-start gap-3 !p-4 text-sm">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-600">
                <Check class="h-3.5 w-3.5" stroke-width={2.5} />
              </span>
              <span class="text-slate-700">{t}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBanner
    title="唔肯定邊個 Plan 啱？"
    description="傳張舊合約或者講下你嘅用量，我哋幫你計邊個最抵。"
  />

  <FaqSection items={faqs} />
</BaseLayout>
