---
import BaseLayout from '../layouts/BaseLayout.astro';
import { agents } from '../config/agents';
import { breadcrumbSchema } from '../lib/schema';

const site = Astro.site?.toString() || 'https://example.com';

const pages = [
  { path: '/', label: '首頁' },
  { path: '/mobile-plan/', label: '手機月費總比較' },
  { path: '/mobile-plan/cmhk/', label: '中國移動香港月費' },
  { path: '/mobile-plan/gba-roaming/', label: '大灣區一卡兩號' },
  { path: '/mobile-plan/student/', label: '學生 Plan' },
  { path: '/broadband/', label: '家居寬頻總比較' },
  { path: '/broadband/estate/public-housing/', label: '公屋寬頻' },
  { path: '/guides/mnp-transfer/', label: '攜號轉台教學' },
];

const schema = breadcrumbSchema(
  [
    { name: '首頁', path: '/' },
    { name: '推廣連結工具', path: '/share/' },
  ],
  site,
);
---

<BaseLayout
  title="推廣連結一鍵生成工具"
  description="專為同事設計：揀自己嘅名同推廣頁面，一鍵複製帶 ?ref= 嘅連結，或直接轉發到 WhatsApp。"
  canonical="/share/"
  schema={schema}
>
  <section class="site-container max-w-xl py-12">
    <h1 class="font-display text-3xl font-bold">推廣連結工具</h1>
    <p class="mt-3 text-ink-soft">
      唔使登入後台。揀你嘅名 → 揀要推嘅頁 → 一鍵複製。客人點開後會鎖定你嘅 WhatsApp 30 日。
    </p>

    <form id="share-form" class="mt-8 space-y-5 rounded-2xl border border-line bg-white/95 p-5 shadow-sm sm:p-6">
      <label class="block text-sm">
        <span class="font-medium">選擇同事名稱</span>
        <select
          id="agent-select"
          class="mt-1.5 w-full rounded-lg border border-line px-3 py-3 text-base"
          required
        >
          <option value="" disabled selected>請選擇…</option>
          {agents.map((a) => <option value={a.id}>{a.name}（{a.id}）</option>)}
        </select>
      </label>

      <label class="block text-sm">
        <span class="font-medium">選擇推廣頁面</span>
        <select id="page-select" class="mt-1.5 w-full rounded-lg border border-line px-3 py-3 text-base">
          {pages.map((p) => <option value={p.path}>{p.label}</option>)}
        </select>
      </label>

      <div>
        <p class="text-sm font-medium">你嘅推廣連結</p>
        <input
          id="share-url"
          type="text"
          readonly
          class="mt-1.5 w-full rounded-lg border border-line bg-mist px-3 py-3 text-sm"
          value=""
          placeholder="揀完上面兩項就會自動出現連結"
        />
      </div>

      <div class="flex flex-col gap-3 sm:flex-row">
        <button type="button" id="copy-btn" class="btn-primary flex-1">
          一鍵複製連結
        </button>
        <a
          id="wa-share-btn"
          class="btn-wa flex-1 text-center"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
        >
          轉發到 WhatsApp
        </a>
      </div>
      <p id="copy-status" class="min-h-[1.25rem] text-sm text-sea" aria-live="polite"></p>
    </form>

    <div class="mt-8 rounded-xl bg-foam/80 p-4 text-sm text-ink-soft">
      <p class="font-semibold text-ink">使用提示</p>
      <ol class="mt-2 list-decimal space-y-1 pl-5">
        <li>複製連結後，可以貼去 WhatsApp、Facebook 或短訊。</li>
        <li>客人用你嘅連結入嚟，之後 30 日內查詢都會搵你。</li>
        <li>如果你未喺名單入面，請叫管理員加你入 agents 設定。</li>
      </ol>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ site }}>
  const agentSelect = document.getElementById('agent-select');
  const pageSelect = document.getElementById('page-select');
  const urlInput = document.getElementById('share-url');
  const copyBtn = document.getElementById('copy-btn');
  const waShareBtn = document.getElementById('wa-share-btn');
  const statusEl = document.getElementById('copy-status');

  function buildUrl() {
    const agent = agentSelect?.value;
    const page = pageSelect?.value || '/';
    if (!agent) {
      urlInput.value = '';
      return '';
    }
    const base = String(site).replace(/\/$/, '');
    const path = page.startsWith('/') ? page : `/${page}`;
    const url = `${base}${path}${path.includes('?') ? '&' : '?'}ref=${encodeURIComponent(agent)}`;
    urlInput.value = url;
    const shareText = `睇下呢個香港電訊格價比較：${url}`;
    waShareBtn.href = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
    return url;
  }

  agentSelect?.addEventListener('change', buildUrl);
  pageSelect?.addEventListener('change', buildUrl);
  buildUrl();

  copyBtn?.addEventListener('click', async () => {
    const url = buildUrl();
    if (!url) {
      statusEl.textContent = '請先選擇同事名稱。';
      return;
    }
    try {
      await navigator.clipboard.writeText(url);
      statusEl.textContent = '已複製！可以貼去 WhatsApp 啦。';
    } catch {
      urlInput.select();
      statusEl.textContent = '請手動長按輸入框複製。';
    }
  });
</script>
