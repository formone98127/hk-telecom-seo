---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlanFilter from '../../components/PlanFilter.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import FaqSection from '../../components/FaqSection.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { getBroadbandPlans, getEstates } from '../../lib/sheets';
import { broadbandCarriers } from '../../lib/carriers';
import { getCurrentMonthLabel, withBase } from '../../lib/utils';
import { breadcrumbSchema, faqSchema, offerSchema } from '../../lib/schema';

const monthLabel = getCurrentMonthLabel();
const plans = await getBroadbandPlans();
const estates = await getEstates();
const site = Astro.site?.toString();

const faqs = [
  {
    question: '1000M 同 2500M 差喺邊？',
    answer:
      '一般家庭串流、視像會議用 1000M 已好夠。如果你屋企多人同時 4K、雲端備份或者電競，可考慮 2500M。',
  },
  {
    question: '拉線要幾耐？',
    answer:
      '市區私樓多數 7–14 個工作天；公屋／居屋要配合屋邨檔期，可能更長。離島物業（如愉景灣）檔期較彈性。',
  },
];

const top = plans.find((p) => p.isRecommended) ?? plans[0];

const schema = [
  breadcrumbSchema(
    [
      { name: '首頁', path: '/' },
      { name: '家居寬頻', path: '/broadband/' },
    ],
    site,
  ),
  faqSchema(faqs),
  offerSchema({
    name: top.planName,
    description: top.highlights,
    price: top.monthlyFee,
    seller: top.carrierName,
    url: '/broadband/',
    site,
  }),
];
---

<BaseLayout
  title={`香港家居寬頻比較｜1000M／2500M 月費格價`}
  description={`${monthLabel}比較 CMHK、HKBN、網上行、3HK 家居寬頻，支援公屋／居屋／私樓篩選同屋苑專頁。`}
  canonical="/broadband/"
  schema={schema}
>
  <section class="site-container pt-10 pb-6">
    <nav class="text-xs text-muted" aria-label="麵包屑">
      <a href={withBase('/')} class="hover:text-sea">首頁</a>
      <span class="mx-1.5">/</span>
      <span>家居寬頻</span>
    </nav>
    <h1 class="mt-3 font-display text-3xl font-bold sm:text-4xl">香港家居寬頻總比較</h1>
    <p class="mt-3 max-w-2xl text-ink-soft">
      對比 1000M／2500M 月費、合約期同拉線注意事項。可用物業類型即時篩選。
    </p>
  </section>

  <section class="site-container pb-4">
    <PlanFilter mode="broadband" carriers={broadbandCarriers} />
  </section>

  <section class="site-container section-pad pt-6">
    <ComparisonTable plans={plans} kind="broadband" />
  </section>

  <section class="site-container pb-12">
    <h2 class="font-display text-xl font-bold">屋苑寬頻專頁</h2>
    <p class="mt-2 text-sm text-muted">揀你屋苑，睇覆蓋、網速同拉線須知。</p>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        estates.map((e) => (
          <li>
            <a
              href={withBase(`/broadband/estate/${e.slug}/`)}
              class="block rounded-xl border border-line bg-white/90 px-4 py-4 transition hover:border-sea-bright"
            >
              <span class="font-semibold text-ink">{e.name}</span>
              <span class="mt-1 block text-xs text-muted">
                {e.district} · {e.housingType}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBanner
    title="話我知你住邊個屋苑"
    description="我哋幫你查邊間可以裝、幾快拉線、有冇免安裝費。"
    message="你好，我想查詢家居寬頻，我嘅屋苑／地區係：（請填寫），請幫我比較 1000M／2500M，謝謝！"
  />

  <FaqSection items={faqs} />
</BaseLayout>
