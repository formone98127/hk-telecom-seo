---
import { MessageCircle, ListOrdered } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import FaqSection from '../../components/FaqSection.astro';
import { getCurrentMonthLabel, withBase } from '../../lib/utils';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';

const monthLabel = getCurrentMonthLabel();
const site = Astro.site?.toString();

const faqs = [
  {
    question: '過冷河係咩意思？',
    answer:
      '「過冷河」一般指舊合約完結後，需要等一段時間先可以再享受新客戶優惠；亦有人用嚟形容轉台空窗期。實際規則因電訊商而異。',
  },
  {
    question: '提早轉台一定要罰錢？',
    answer:
      '如果仲喺合約期內，多數要付提早終止費用。不過新電訊商有時會提供回贈或代支優惠，可以互相抵銷一部分。',
  },
];

const schema = [
  breadcrumbSchema(
    [
      { name: '首頁', path: '/' },
      { name: '攜號轉台教學', path: '/guides/mnp-transfer/' },
    ],
    site,
  ),
  faqSchema(faqs),
];

const steps = [
  {
    title: '第一步：確認舊約狀態',
    body: '睇清楚合約到期日、提早終止費用、仲有冇分期機款。可以登入電訊商 App 或打熱線問「MNP／攜號轉台結算金額」。',
  },
  {
    title: '第二步：揀新 Plan 同申請轉台',
    body: '比較月費、數據、大灣區同隱藏優惠後，向新電訊商提交攜號轉台申請（需要身份證同現有電話號碼）。',
  },
  {
    title: '第三步：等待批核同轉台日',
    body: '一般 1–2 個工作天。轉台當日保持舊 SIM 可用，直至收到成功短訊或新 SIM 啟用指示。',
  },
  {
    title: '第四步：啟用新 SIM／eSIM',
    body: '跟指示啟動新卡，測試通話、數據同 SMS。如有問題即時聯絡新商客服或經本站 WhatsApp 跟進。',
  },
];
---

<BaseLayout
  title={`香港攜號轉台教學｜程序、過冷河同提早轉台計算`}
  description={`${monthLabel}詳解香港攜號轉台步驟、合約未完計費方法同過冷河注意事項，文中附免費 WhatsApp 諮詢。`}
  canonical="/guides/mnp-transfer/"
  schema={schema}
  ogType="article"
>
  <article>
    <header class="site-container pt-10 pb-8">
      <nav class="text-xs text-slate-500" aria-label="麵包屑">
        <a href={withBase('/')} class="hover:text-blue-600">首頁</a>
        <span class="mx-1.5">/</span>
        <span>攜號轉台教學</span>
      </nav>
      <p class="mt-4 text-sm font-semibold text-blue-600">{monthLabel}實用指南</p>
      <h1 class="mt-2 font-display text-3xl font-bold leading-tight tracking-tight text-slate-900 sm:text-4xl">
        香港攜號轉台完整教學
      </h1>
      <p class="mt-4 max-w-2xl text-slate-600">
        想轉去更抵嘅月費又唔想轉號碼？呢篇拆解攜號轉台程序、提早轉台點計錢，以及過冷河要注意咩。
      </p>
    </header>

    <div class="site-container max-w-3xl pb-8">
      <div class="prose-guide prose prose-slate">
        <section>
          <h2>攜號轉台係咩？</h2>
          <p>
            攜號轉台（Mobile Number Portability，MNP）即係保留你現有電話號碼，轉去另一間電訊商。香港四大手機商（CMHK、3HK、csl.、SmarTone）都支援。
          </p>
        </section>

        <section class="not-prose mt-10 space-y-4">
          <div class="mb-2 flex items-center gap-2">
            <ListOrdered class="h-5 w-5 text-blue-600" stroke-width={2} />
            <h2 class="font-display text-xl font-bold tracking-tight text-slate-900">圖文步驟</h2>
          </div>
          {
            steps.map((step, i) => (
              <div class="bento-card">
                <p class="text-xs font-bold tracking-wider text-blue-600 uppercase">
                  Step {i + 1}
                </p>
                <h3 class="mt-1 font-semibold text-slate-900">{step.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">{step.body}</p>
              </div>
            ))
          }
        </section>

        <aside class="not-prose mt-10 rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm sm:p-6">
          <p class="font-display text-lg font-bold text-slate-900">計唔清舊約費用？</p>
          <p class="mt-2 text-sm text-slate-600">
            傳張舊合約截圖或者到期日，我哋幫你估提早轉台划唔划算，同有冇新商回贈可以對沖。
          </p>
          <a
            href="#"
            class="btn-wa mt-4 wa-link"
            data-wa-message="你好，我想了解攜號轉台同舊約費用點計，請幫我睇下，謝謝！"
          >
            <MessageCircle class="h-4 w-4" stroke-width={2} />
            WhatsApp 問攜號轉台
          </a>
        </aside>

        <section class="mt-10">
          <h2>合約未完提早轉台點計？</h2>
          <p>
            粗略公式：<strong>餘下合約月數 × 每月最低消費</strong>，再加埋未付機款／行政費（如有）。不同電訊商條款唔一樣，以書面報價為準。
          </p>
          <p>
            如果新 Plan 月費平好多，或者新商提供「幫你清舊約／回贈」，有時提早轉仍然更著數。
          </p>
        </section>

        <section>
          <h2>過冷河注意事項</h2>
          <ul>
            <li>確認新約生效日，避免舊新服務重疊收費。</li>
            <li>轉台前後備份重要 SMS（銀行 OTP 等）。</li>
            <li>如果用 eSIM，確保手機已解鎖同支援該商 eSIM。</li>
            <li>公司機／附屬號碼可能有額外限制，要先問清楚。</li>
          </ul>
        </section>

        <section>
          <h2>點樣揀更抵嘅新 Plan？</h2>
          <p>
            可以先睇本站
            <a href={withBase('/mobile-plan/')}>5G 月費總比較</a>
            ，特別係標記「編輯首選」嘅中國移動香港計劃，多數喺月費同大灣區數據之間較平衡。
          </p>
        </section>
      </div>
    </div>

    <CtaBanner
      title="準備好轉台？我哋幫你一條龍"
      description="由計舊約、遞交申請到啟用新卡，WhatsApp 跟進就得。"
      message="你好，我想辦理香港攜號轉台，請指引我下一步，謝謝！"
    />

    <FaqSection title="攜號轉台 FAQ" items={faqs} />
  </article>
</BaseLayout>
